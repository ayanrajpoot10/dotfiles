# THEME
set recolor true
set recolor-darkcolor "#cdd6f4"
set recolor-lightcolor "#1e1e2e"
set recolor-keephue true
set recolor-reverse-video true

set default-bg "#1e1e2e"
set index-bg "#1e1e2e"
set statusbar-bg "#181825"
set completion-bg "#181825"
set inputbar-bg "#181825"
set completion-group-bg "#11111b"
set completion-highlight-bg "#cba6f7"
set index-active-bg "#cba6f7"
set default-fg "#cdd6f4"
set index-fg "#cdd6f4"
set statusbar-fg "#cdd6f4"
set completion-fg "#cdd6f4"
set inputbar-fg "#cdd6f4"
set completion-group-fg "#bac2de"
set index-active-fg "#313244"

set highlight-color "rgba(203,166,247,0.45)"
set highlight-active-color "rgba(137,180,250,0.55)"

# UI
set guioptions none
set font "JetBrainsMono Nerd Font 11"

set statusbar-basename true
set window-title-basename true
set statusbar-home-tilde true

# OPENING & VIEW
set adjust-open "best-fit"
set vertical-center true
set zoom-center true

# SCROLLING
set scroll-step 150
set scroll-page-aware true
set scroll-full-overlap 0.15

# PERFORMANCE
set page-cache-size 5
set render-loading false

# SEARCH
set incremental-search true
set abort-clear-search true

# HISTORY
set database "sqlite"

# CLIPBOARD
set selection-clipboard clipboard
set selection-notification false

set page-v-padding 0

map j scroll smooth-down
map k scroll smooth-up
